{
    "manifest_version": 2,
    "name": "furigana.it",
    "version": "0.1.0",
    "description": "Add furigana to any Japanese webpage.",
    "icons": {
        "96": "icons/icon.svg"
    },
    "background": {
        "scripts": [
            "background.js"
        ],
        "persistent": true
    },
    "content_scripts": [
        {
            "matches": [
                "*://*.mozilla.org/*"
            ],
            "js": [
                "content.js"
            ]
        }
    ],
    "permissions": [
        "contextMenus",
        "activeTab"
    ]
}